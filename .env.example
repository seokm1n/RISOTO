# PostgreSQL 18.4 + pgvector 0.8.6 build
POSTGRES_VERSION=18.4-bookworm
PG_MAJOR=18
PGVECTOR_VERSION=0.8.6

# Local development database
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=

TZ=Asia/Seoul

# Backend container connection string (host name is the Compose service name: db)
DATABASE_URL=postgresql+psycopg://risoto_app:change_this_local_password@db:5432/risoto

# Backend running directly on Windows (outside Docker)
DATABASE_URL_HOST=postgresql+psycopg://risoto_app:change_this_local_password@localhost:5432/risoto

# FastAPI
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# External collection APIs (keep real values only in .env)
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
TAVILY_API_KEY=
KAKAO_REST_API_KEY=
SERPAPI_API_KEY=
# 설정하면 백필·수동·실시간 수집에서 YouTube 영상 댓글을 수집합니다.
YOUTUBE_API_KEY=

# Optional generic collection incident webhook (Slack/Teams relay or custom receiver)
COLLECTION_ALERT_WEBHOOK_URL=
COLLECTION_ALERT_WEBHOOK_TIMEOUT_SECONDS=5
COLLECTION_RETRY_DELAYS_SECONDS=60,300,900
PARTIAL_FAILURE_CONSECUTIVE_THRESHOLD=2
COLLECTION_WINDOW_MINUTES=15

# Authentication
SESSION_COOKIE_NAME=risoto_session
CSRF_COOKIE_NAME=risoto_csrf
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false

# Monitoring and ML
SENTIMENT_MODEL_NAME=Huffon/klue-roberta-base-nli
SENTIMENT_ALLOW_MODEL_DOWNLOAD=true
PRETRAINED_SENTIMENT_MODEL_PATH=/app/local_models/KLUE-ROBERTa-감성분석모델
REALTIME_INTERVAL_SECONDS=900
REALTIME_OVERLAP_MINUTES=60
BASELINE_MIN_ARTICLES=20
BASELINE_MIN_DAYS=3
ARTICLE_FILTER_VERSION=hybrid-klue-roberta-v2
ARTICLE_FILTER_AI_ENABLED=true
ARTICLE_FILTER_CLASSIFIER_MODEL=Huffon/klue-roberta-base-nli
ARTICLE_FILTER_SEMANTIC_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ARTICLE_FILTER_ALLOW_MODEL_DOWNLOAD=true
PRETRAINED_RELEVANCE_MODEL_PATH=/app/local_models/KLUE-ROBERTa-분류학습모델_v2
EXTERNAL_LIGHTGBM_MODEL_PATH=/app/local_models/LightGBM 모델 라벨링(정답) 데이터/lightgbm_risk_model_auto_v3.txt
ARTICLE_FILTER_DUPLICATE_THRESHOLD=0.92
ARTICLE_FILTER_ADVERTISING_REJECT_THRESHOLD=0.85
ARTICLE_FILTER_ADVERTISING_REVIEW_THRESHOLD=0.55
ARTICLE_FILTER_RELEVANCE_ACCEPT_THRESHOLD=0.70
ARTICLE_FILTER_RELEVANCE_REJECT_THRESHOLD=0.30
STORY_CLUSTER_SIMILARITY_THRESHOLD=0.72
STORY_CLUSTER_LOOKBACK_HOURS=72
READINESS_MIN_ARTICLES=50
READINESS_MIN_NONEMPTY_WINDOWS=40
RISK_DEFAULT_THRESHOLD=0.65
RISK_CLOSE_THRESHOLD=0.45
RISK_CLOSE_CONSECUTIVE_WINDOWS=2
RISK_TYPE_NLI_ENABLED=true
RETRAIN_MIN_NEW_ARTICLE_LABELS=200
RETRAIN_MIN_NEW_RISK_EVENT_LABELS=20
MODEL_DRIFT_ROBUST_Z_THRESHOLD=3.5
MODEL_DRIFT_RECENT_HOURS=24
MODEL_DRIFT_BASELINE_DAYS=7

# Grounded response drafts (optional; deterministic template fallback is used without a key)
OPENAI_API_KEY=
RESPONSE_MODEL_NAME=gpt-5.6-luna
