# Shared/external PostgreSQL connection string used by the backend container
DATABASE_URL=postgresql+psycopg://risoto_app:change_this_password@database.example.com:7001/risoto

# Backend running directly on Windows (outside Docker); usually the same external URL
DATABASE_URL_HOST=postgresql+psycopg://risoto_app:change_this_password@database.example.com:7001/risoto

# Set true only when this instance is responsible for upgrading the shared database.
RUN_DB_MIGRATIONS=false

# FastAPI
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# External collection APIs (keep real values only in .env)
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
TAVILY_API_KEY=
KAKAO_REST_API_KEY=
SERPAPI_API_KEY=
# 설정하면 백필·수동·실시간 수집에서 YouTube 영상 댓글을 수집합니다.
YOUTUBE_API_KEY=

# Optional generic collection incident webhook (Slack/Teams relay or custom receiver)
COLLECTION_ALERT_WEBHOOK_URL=
COLLECTION_ALERT_WEBHOOK_TIMEOUT_SECONDS=5
COLLECTION_RETRY_DELAYS_SECONDS=60,300,900
PARTIAL_FAILURE_CONSECUTIVE_THRESHOLD=2
COLLECTION_WINDOW_MINUTES=15

# Authentication
SESSION_COOKIE_NAME=risoto_session
CSRF_COOKIE_NAME=risoto_csrf
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false

SENTIMENT_MODEL_NAME=Huffon/klue-roberta-base-nli
SENTIMENT_ALLOW_MODEL_DOWNLOAD=true
PRETRAINED_SENTIMENT_MODEL_PATH=/app/local_models/klue_roberta_domain_finetuned
REALTIME_INTERVAL_SECONDS=900
REALTIME_OVERLAP_MINUTES=60
BASELINE_MIN_ARTICLES=20
BASELINE_MIN_DAYS=3
ARTICLE_FILTER_VERSION=hybrid-company-reranker-v5
ARTICLE_FILTER_AI_ENABLED=true
ARTICLE_FILTER_CLASSIFIER_MODEL=Huffon/klue-roberta-base-nli
ARTICLE_FILTER_SEMANTIC_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ARTICLE_FILTER_ALLOW_MODEL_DOWNLOAD=true
PRETRAINED_RELEVANCE_MODEL_PATH=/app/local_models/klue_roberta_spam_finetuned_v2
ARTICLE_FILTER_DUPLICATE_THRESHOLD=0.92
ARTICLE_FILTER_ADVERTISING_REJECT_THRESHOLD=0.85
ARTICLE_FILTER_ADVERTISING_REVIEW_THRESHOLD=0.55
ARTICLE_FILTER_RELEVANCE_ACCEPT_THRESHOLD=0.70
ARTICLE_FILTER_RELEVANCE_REJECT_THRESHOLD=0.30
COMPANY_RERANKER_ENABLED=true
COMPANY_RERANKER_BASE_MODEL=BAAI/bge-reranker-v2-m3
COMPANY_RERANKER_MAX_LENGTH=512
COMPANY_RERANKER_BATCH_SIZE=8
STORY_CLUSTER_RECENT_HOURS=168
STORY_CLUSTER_FOLLOWUP_HOURS=720
STORY_CLUSTER_CANDIDATE_LIMIT=1500
STORY_CLUSTER_SEMANTIC_CANDIDATE_LIMIT=80
STORY_CLUSTER_EMBEDDING_BATCH_SIZE=256
READINESS_MIN_ARTICLES=50
READINESS_MIN_NONEMPTY_WINDOWS=40
RISK_DEFAULT_THRESHOLD=0.65
RISK_CLOSE_THRESHOLD=0.45
RISK_CLOSE_CONSECUTIVE_WINDOWS=2
RISK_TYPE_NLI_ENABLED=true
STORY_RISK_ENGINE_ENABLED=true
# 위험 이벤트 발생 시 대응방안 자동 생성. 끄면 수동 버튼으로만 만든다(LLM 비용 통제용)
RESPONSE_DRAFT_AUTO_ENABLED=true
ARTICLE_RISK_CANDIDATE_THRESHOLD=0.65
ARTICLE_RISK_HIGH_THRESHOLD=0.80
ARTICLE_RISK_UNCERTAIN_LOW=0.35
ARTICLE_RISK_LLM_MAX_PER_RUN=20
STORY_EVENT_MIN_ARTICLES=2
STORY_EVENT_INACTIVITY_DAYS=3
STORY_EVENT_REBUILD_HOURS=72
RETRAIN_MIN_NEW_ARTICLE_LABELS=200
RETRAIN_MIN_NEW_RISK_EVENT_LABELS=20
MODEL_DRIFT_ROBUST_Z_THRESHOLD=3.5
MODEL_DRIFT_RECENT_HOURS=24
MODEL_DRIFT_BASELINE_DAYS=7

# Grounded response drafts (optional; deterministic template fallback is used without a key)
OPENAI_API_KEY=
RESPONSE_MODEL_NAME=gpt-5.6-luna
LLM_LABELING_MODEL_NAME=gpt-4o-mini
