# PostgreSQL 18.4 + pgvector 0.8.6 build
POSTGRES_VERSION=18.4-bookworm
PG_MAJOR=18
PGVECTOR_VERSION=0.8.6

# Local development database
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=

TZ=Asia/Seoul

# Backend container connection string (host name is the Compose service name: db)
DATABASE_URL=postgresql+psycopg://risoto_app:change_this_local_password@db:5432/risoto

# Backend running directly on Windows (outside Docker)
DATABASE_URL_HOST=postgresql+psycopg://risoto_app:change_this_local_password@localhost:5432/risoto

# FastAPI
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# External collection APIs (keep real values only in .env)
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
TAVILY_API_KEY=
SERPAPI_API_KEY=
YOUTUBE_API_KEY=

# Monitoring and ML
SENTIMENT_MODEL_NAME=daekeun-ml/koelectra-small-v3-nsmc
REALTIME_INTERVAL_SECONDS=900
REALTIME_OVERLAP_MINUTES=60
BASELINE_MIN_ARTICLES=20
BASELINE_MIN_DAYS=3
